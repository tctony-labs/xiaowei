# Pin the digest printed by the server image publishing workflow.
XIAOWEI_SERVER_IMAGE=ghcr.io/tctony-labs/xiaowei-server@sha256:REPLACE_WITH_PUBLISHED_DIGEST

# Generate a unique password before the first deployment; never reuse the development password.
XIAOWEI_DATABASE_PASSWORD='REPLACE_WITH_RANDOM_PASSWORD'
XIAOWEI_DATABASE_NAME=xiaowei
XIAOWEI_DATABASE_USER=xiaowei

# Set both for the first startup, then remove both and recreate only the server container.
# XIAOWEI_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# XIAOWEI_BOOTSTRAP_ADMIN_PASSWORD='REPLACE_WITH_ADMIN_PASSWORD'

# Optional host loopback port; the container always listens on 10001.
# XIAOWEI_SERVER_PORT=10001

# Trust only the actual host reverse-proxy peer, determined from the Compose network gateway.
# XIAOWEI_TRUSTED_PROXY_CIDRS=172.18.0.1/32
