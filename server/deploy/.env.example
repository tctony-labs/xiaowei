# Prefer the NJU mirror and keep the exact digest printed by the publishing workflow.
# If the mirror is unavailable, verify the same digest from ghcr.io before selecting that reference.
# Keep this reference aligned with image= in the deployment root's release.txt.
XIAOWEI_SERVER_IMAGE=ghcr.nju.edu.cn/tctony-labs/xiaowei-server@sha256:REPLACE_WITH_PUBLISHED_DIGEST

# Generate a unique password before the first deployment; never reuse the development password.
XIAOWEI_DATABASE_PASSWORD='REPLACE_WITH_RANDOM_PASSWORD'
XIAOWEI_DATABASE_NAME=xiaowei
XIAOWEI_DATABASE_USER=xiaowei

# Used only when the database has no administrator initialization record; set both before first startup.
# Keep these settings after initialization; changing them does not reset an existing administrator password.
# Before an explicitly requested database reset, set the intended email and password again.
# Password must be 6-32 printable ASCII characters; do not use the placeholder as a real password.
# XIAOWEI_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# XIAOWEI_BOOTSTRAP_ADMIN_PASSWORD='REPLACE_WITH_ADMIN_PASSWORD'

# Optional host loopback port; the container always listens on 10001.
# XIAOWEI_SERVER_PORT=10001

# Trust only the actual host reverse-proxy peer, determined from the Compose network gateway.
# XIAOWEI_TRUSTED_PROXY_CIDRS=172.18.0.1/32
