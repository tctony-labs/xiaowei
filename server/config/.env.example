# Shared by Go and Docker Compose. Default password for local development.
XIAOWEI_DATABASE_PASSWORD='password'

# Optional database initialization overrides, applied to both Go and Compose.
# XIAOWEI_DATABASE_NAME=xiaowei
# XIAOWEI_DATABASE_USER=xiaowei

# Other optional Go overrides (external process env has highest priority).
# XIAOWEI_LISTEN_ADDR=127.0.0.1:10001
# XIAOWEI_DATABASE_HOST=127.0.0.1
# XIAOWEI_DATABASE_PORT=5432
# XIAOWEI_DATABASE_SSL_MODE=disable

# Optional authentication lifetime overrides.
# XIAOWEI_AUTH_ACCESS_TOKEN_TTL=2h
# XIAOWEI_AUTH_REFRESH_TOKEN_TTL=720h

# Container image reference. Set a published version or digest when CI publishing is available.
# XIAOWEI_SERVER_IMAGE=xiaowei-server:local

# Single-quote passwords containing $ or # so both readers preserve them literally.
# Database initialization overrides affect only empty PostgreSQL volumes.

# Optional HTTP rate limits (positive limits and durations).
# XIAOWEI_SERVER_RATE_LIMIT_IP_LIMIT=300
# XIAOWEI_SERVER_RATE_LIMIT_IP_WINDOW=1m
# XIAOWEI_AUTH_RATE_LIMIT_LOGIN_IP_LIMIT=30
# XIAOWEI_AUTH_RATE_LIMIT_LOGIN_IP_WINDOW=1m
# XIAOWEI_AUTH_RATE_LIMIT_LOGIN_EMAIL_IP_LIMIT=5
# XIAOWEI_AUTH_RATE_LIMIT_LOGIN_EMAIL_IP_WINDOW=15m
# XIAOWEI_AUTH_RATE_LIMIT_REFRESH_IP_LIMIT=60
# XIAOWEI_AUTH_RATE_LIMIT_REFRESH_IP_WINDOW=1m

# Optional one-time administrator initialization; set both, then remove both after success.
# Password must be 6-32 printable ASCII characters; there are no default administrator credentials.
# XIAOWEI_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# XIAOWEI_BOOTSTRAP_ADMIN_PASSWORD='your-password'
