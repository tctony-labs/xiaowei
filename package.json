{
  "name": "xiaowei-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=26.3.1 <27"
  },
  "scripts": {
    "check": "pnpm contracts:check && biome check . && pnpm -r check",
    "fmt": "biome check --write .",
    "test": "pnpm test:tooling && pnpm -r test",
    "build": "pnpm -r build",
    "prepare": "husky",
    "contracts:generate": "node contracts/generate.mjs",
    "contracts:check": "node contracts/generate.mjs --check",
    "contracts:test": "node contracts/tests/codec.mjs",
    "gateway:test-native": "node gateway/tests/native.mjs",
    "test:tooling": "node --test scripts/tests/*.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "husky": "9.1.7",
    "typescript": "5.9.3",
    "electron-vite": "5.0.0",
    "vite": "7.3.6",
    "nodemon": "3.1.14"
  }
}
