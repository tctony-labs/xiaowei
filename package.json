{
  "name": "xiaowei-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=26.3.1 <27"
  },
  "scripts": {
    "check": "pnpm contracts:check && pnpm gateway:check && biome check . && pnpm -r check",
    "fmt": "biome check --write .",
    "test": "pnpm build:native && pnpm test:tooling && pnpm test:patches && pnpm -r test",
    "build:native": "pnpm --filter './crates/*/napi' --workspace-concurrency=1 run build:debug",
    "build": "pnpm -r build",
    "prepare": "husky",
    "contracts:generate": "node contracts/generate.mjs",
    "contracts:check": "node contracts/generate.mjs --check",
    "contracts:test": "node contracts/tests/codec.mjs",
    "gateway:generate": "cargo run --locked -q -p xw-gateway --example generate_business -- --write",
    "gateway:check": "cargo run --locked -q -p xw-gateway --example generate_business -- --check",
    "gateway:test-native": "node gateway/tests/native.mjs",
    "test:patches": "node --experimental-import-meta-resolve --test patches/tests/*.test.mjs",
    "test:tooling": "node --test scripts/dev/*.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "husky": "9.1.7",
    "typescript": "5.9.3",
    "electron-vite": "5.0.0",
    "vite": "7.3.6",
    "nodemon": "3.1.14"
  }
}
