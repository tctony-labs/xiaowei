+// Generic Responses keeps its own request, authentication and pricing options.
+export async function processResponsesWebSocket(url, params, headers, output, stream, model,
+    grammarToolInputProperties, options, responseOptions) {
+    const { stream: _stream, ...body } = params;
+    let retriedContinuation = false;
+    while (true) {
+        let sent = false;
+        let continued = false;
+        let started = false;
+        try {
+            await processWebSocketStream(
+                url, body, headers, output, stream, model,
+                () => {
+                    started = true;
+                    stream.push({ type: "start", partial: output });
+                },
+                normalizeTimeoutMs(options?.timeoutMs), normalizeTimeoutMs(options?.websocketConnectTimeoutMs),
+                options?.sessionId, `api-key:${model.provider}`, grammarToolInputProperties, options,
+                (requestBody) => {
+                    sent = true;
+                    continued = Boolean(requestBody.previous_response_id);
+                },
+                responseOptions,
+            );
+            return true;
+        }
+        catch (error) {
+            if (options?.signal?.aborted) throw error;
+            if (!started && continued && isPreviousResponseNotFoundError(error) && !retriedContinuation) {
+                retriedContinuation = true;
+                continue;
+            }
+            // Once sent, a lost response does not prove the request was rejected.
+            if (!sent && options?.transport === "auto") return false;
+            throw error;
+        }
+    }
