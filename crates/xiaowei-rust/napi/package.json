{
  "name": "xiaowei-rust",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "napi": {
    "binaryName": "xiaowei-rust"
  },
  "scripts": {
    "build": "node ../../../scripts/dev/build-napi.mjs --release",
    "build:debug": "node ../../../scripts/dev/build-napi.mjs",
    "check": "cargo check -p xiaowei-rust-napi --locked",
    "test": "node --conditions=source --import tsx --test test/**/*.test.cjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.1",
    "tsx": "4.23.13",
    "xiaowei-gateway": "workspace:*",
    "@bufbuild/protobuf": "catalog:",
    "xiaowei-agent": "workspace:*",
    "xiaowei-contracts": "workspace:*"
  }
}
