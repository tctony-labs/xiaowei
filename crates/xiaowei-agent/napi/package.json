{
  "name": "xiaowei-agent",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "napi": {
    "binaryName": "xiaowei-agent"
  },
  "scripts": {
    "build": "node ../../../scripts/dev/build-napi.mjs --release",
    "build:debug": "node ../../../scripts/dev/build-napi.mjs",
    "check": "cargo check -p xiaowei-agent-napi --locked",
    "test:runtime": "node --conditions=source --import tsx --test test/*.test.cjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.1",
    "tsx": "4.23.13",
    "xiaowei-gateway": "workspace:*",
    "xiaowei-contracts": "workspace:*",
    "@bufbuild/protobuf": "2.15.0"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  }
}
