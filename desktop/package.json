{
  "name": "@xiaowei/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter xiaowei-gateway build && electron-vite build",
    "check": "pnpm --filter xiaowei-gateway build && tsgo -p tsconfig.node.json && tsgo -p tsconfig.web.json",
    "smoke": "electron scripts/smoke.mjs",
    "package": "electron-builder --dir",
    "dev:main": "node scripts/build-main.mjs && electron .",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "storybook:build": "storybook build --disable-telemetry"
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "xiaowei-clipboard": "workspace:*",
    "xiaowei-search": "workspace:*",
    "zustand": "5.0.8",
    "xiaowei-gateway": "workspace:*",
    "xiaowei-contracts": "workspace:*",
    "@bufbuild/protobuf": "2.15.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "nodemon": "3.1.14",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "vite": "7.3.6"
  },
  "description": "XiaoWei desktop client"
}
