{
  "name": "@xiaowei/desktop",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "test": "node tests/run.mjs",
    "dev": "node ../scripts/dev/dev.mjs",
    "build": "electron-vite build",
    "check": "tsgo -p tsconfig.node.json && tsgo -p tsconfig.web.json",
    "package": "electron-builder --dir",
    "package:mac": "node ../scripts/release/package-mac.mjs",
    "package:mac:test": "node ../scripts/release/local-update.mjs",
    "update:mac:serve": "node ../scripts/release/local-update-server.mjs",
    "dev:main": "node ../scripts/dev/build-desktop-main.mjs && electron .",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "storybook:build": "storybook build --disable-telemetry"
  },
  "dependencies": {
    "xiaowei-agent": "workspace:*",
    "xiaowei-rust": "workspace:*"
  },
  "devDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zustand": "5.0.8",
    "tsx": "4.23.13",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "vite": "7.3.6",
    "@xiaowei/source-log": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "jsdom": "^30.1.0",
    "vitest": "5.0.1",
    "@earendil-works/pi-ai": "0.87.1",
    "electron-log": "5.4.4",
    "xiaowei-gateway": "workspace:*",
    "xiaowei-contracts": "workspace:*",
    "@bufbuild/protobuf": "catalog:"
  },
  "description": "XiaoWei desktop client"
}
