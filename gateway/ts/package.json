{
  "name": "xiaowei-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./host": {
      "types": "./src/core/registry.ts",
      "source": "./src/core/registry.ts",
      "import": "./dist/core/registry.js"
    },
    "./protocol": {
      "types": "./src/core/protocol.ts",
      "source": "./src/core/protocol.ts",
      "import": "./dist/core/protocol.js"
    },
    "./native": {
      "types": "./src/main/native.ts",
      "source": "./src/main/native.ts",
      "import": "./dist/main/native.js"
    },
    "./electron": {
      "types": "./src/main/electron.ts",
      "source": "./src/main/electron.ts",
      "import": "./dist/main/electron.js"
    },
    "./preload": {
      "types": "./src/preload/index.ts",
      "source": "./src/preload/index.ts",
      "import": "./dist/preload/index.js"
    },
    "./renderer": {
      "types": "./src/renderer/index.ts",
      "source": "./src/renderer/index.ts",
      "import": "./dist/renderer/index.js"
    },
    "./worker-host": {
      "types": "./src/main/worker.ts",
      "source": "./src/main/worker.ts",
      "import": "./dist/main/worker.js"
    },
    "./worker": {
      "types": "./src/worker/endpoint.ts",
      "source": "./src/worker/endpoint.ts",
      "import": "./dist/worker/endpoint.js"
    }
  },
  "scripts": {
    "check": "tsgo --noEmit",
    "test": "tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "test:worker-built": "pnpm build && node --test test/worker-built.test.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0"
  },
  "devDependencies": {
    "xiaowei-contracts": "workspace:*",
    "@types/node": "26.5.1",
    "tsx": "4.23.13",
    "electron": "44.3.0"
  }
}
