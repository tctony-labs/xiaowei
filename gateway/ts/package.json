{
  "name": "xiaowei-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/core/registry.d.ts",
      "import": "./dist/core/registry.js"
    },
    "./protocol": {
      "types": "./dist/core/protocol.d.ts",
      "import": "./dist/core/protocol.js"
    },
    "./native": {
      "types": "./dist/main/native.d.ts",
      "import": "./dist/main/native.js"
    }
  },
  "scripts": {
    "check": "tsgo --noEmit",
    "test": "tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0"
  },
  "devDependencies": {
    "xiaowei-contracts": "workspace:*",
    "@types/node": "26.5.1",
    "tsx": "4.23.13"
  }
}
